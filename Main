
import os
import logging
from telegram import Update
from telegram.ext import (
    Application,
    ContextTypes,
    MessageHandler,
    filters,
)

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

BOT_TOKEN = os.environ.get("BOT_TOKEN", "")
SOURCE_CHAT_ID = os.environ.get("SOURCE_CHAT_ID", "")
TARGET_CHAT_ID = os.environ.get("TARGET_CHAT_ID", "")


def parse_chat_id(value):
    value = value.strip()
    if not value:
        return None
    try:
        return int(value)
    except ValueError:
        return value


SOURCE = parse_chat_id(SOURCE_CHAT_ID)
TARGET = parse_chat_id(TARGET_CHAT_ID)


async def forward_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.effective_chat or not update.effective_message:
        return

    if update.effective_chat.id != SOURCE:
        return

    try:
        await context.bot.forward_message(
            chat_id=TARGET,
            from_chat_id=update.effective_chat.id,
            message_id=update.effective_message.message_id,
        )
        logger.info("Message forwarded successfully")
    except Exception:
        logger.exception("Failed to forward message")


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_message:
        await update.effective_message.reply_text(
            "Telegram forwarder is running!"
        )


def main():
    if not BOT_TOKEN or SOURCE is None or TARGET is None:
        raise RuntimeError("Please configure all Railway environment variables.")

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(
        MessageHandler(filters.COMMAND & filters.Regex(r"^/start(?:@\w+)?$"), start)
    )
    app.add_handler(
        MessageHandler(filters.ALL & ~filters.COMMAND, forward_message)
    )

    logger.info("Telegram forwarder starting...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ ==  main.py
